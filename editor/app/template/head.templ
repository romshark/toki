package template

import (
	"strings"

	"github.com/romshark/toki/editor/app/datapagesgen/assets"
)

func prefsStyleTag(p UIPrefs) string {
	if p.UIFontCSS == "" && p.EditorFontCSS == "" &&
		p.UIFontSizeCSS == "" && p.EditorFontSizeCSS == "" &&
		p.SidebarWidthCSS == "" {
		return ""
	}
	var s strings.Builder
	s.WriteString("<style>:root{")
	if p.UIFontCSS != "" {
		s.WriteString("--font-ui:")
		s.WriteString(p.UIFontCSS)
		s.WriteByte(';')
	}
	if p.EditorFontCSS != "" {
		s.WriteString("--font-editor:")
		s.WriteString(p.EditorFontCSS)
		s.WriteByte(';')
	}
	if p.UIFontSizeCSS != "" {
		s.WriteString("--font-size-ui:")
		s.WriteString(p.UIFontSizeCSS)
		s.WriteByte(';')
	}
	if p.EditorFontSizeCSS != "" {
		s.WriteString("--font-size-editor:")
		s.WriteString(p.EditorFontSizeCSS)
		s.WriteByte(';')
	}
	if p.SidebarWidthCSS != "" {
		s.WriteString("--sidebar-width:")
		s.WriteString(p.SidebarWidthCSS)
		s.WriteByte(';')
	}
	s.WriteString("}</style>")
	return s.String()
}

templ Head(prefs UIPrefs) {
	<title>Toki Editor</title>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta charset="UTF-8"/>
	<link rel="stylesheet" href={ assets.Path("morpheus.css") }/>
	<link rel="stylesheet" href={ assets.Path("theme-default.css") }/>
	// Set dark/light class before any content renders to avoid FOUC.
	switch prefs.Theme {
		case "dark":
			<script>document.documentElement.classList.add('dark')</script>
		case "light":
			<script>document.documentElement.classList.add('light')</script>
		default:
			<script>
				if(matchMedia('(prefers-color-scheme:dark)').matches) {
					document.documentElement.classList.add('dark')
				}
			</script>
	}
	// Set the motion attribute before any content renders, which keeps it
	// from animating. System leaves the OS preference to the CSS.
	switch prefs.Motion {
		case "reduced":
			<script>
				document.documentElement.setAttribute('data-pref-reduced-motion','')
			</script>
		case "animated":
			<script>
				document.documentElement.setAttribute('data-pref-full-motion','')
			</script>
	}
	// Set the contrast attribute before any content renders. System leaves
	// the OS preference to the CSS.
	switch prefs.Contrast {
		case "more":
			<script>
				document.documentElement.setAttribute('data-pref-contrast-more','')
			</script>
		case "standard":
			<script>
				document.documentElement.setAttribute('data-pref-contrast-standard','')
			</script>
	}
	// Inject CSS custom properties for user font preferences on :root.
	// templ.Raw is acceptable here because templ has no native construct
	// for <style> tags with dynamic content.
	@templ.Raw(prefsStyleTag(prefs))
	<script type="module" src={ assets.Path("morpheus.js") }></script>
	<script src={ assets.Path("bundle.js") }></script>
	<link rel="stylesheet" href={ assets.Path("style.min.css") }/>
}
