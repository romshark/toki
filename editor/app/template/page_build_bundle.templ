package template

import (
	"github.com/romshark/morpheus/neo"

	"github.com/romshark/toki/editor/app/datapagesgen/href"
	"github.com/romshark/toki/internal/tokibundle"
)

// PageBuildBundle renders the whole build page. It is both the GET body
// and what PageBuildBundle.OnUpdated morphs as the build progresses.
templ PageBuildBundle(tr tokibundle.Reader, state BuildBundleState) {
	@page("page-build-bundle", nil) {
		<div class="page-center">
			@buildBundleStatus(tr, state)
		</div>
	}
}

// buildBundleCard renders the page's single status card. Every build
// state shows the same title-over-body shape, so only the heading and
// the body content differ.
templ buildBundleCard(title string) {
	@neo.Card(neo.CardOpts{}) {
		@neo.CardHeader() {
			@neo.CardTitle() {
				<h1>{ title }</h1>
			}
		}
		@neo.CardBody() {
			{ children... }
		}
	}
}

// componentDashboardLink renders the "Go to Dashboard" call to action
// shared by the build page's terminal states.
templ componentDashboardLink(tr tokibundle.Reader) {
	@neo.Link(neo.LinkOpts{
		Href:    neo.Set(href.PageIndex()),
		Variant: neo.Set(neo.LinkVariantButtonPrimary),
	}) {
		{ tr.String("Go to Dashboard") }
	}
}

// buildBundleStatus renders the card of the current build state.
templ buildBundleStatus(tr tokibundle.Reader, state BuildBundleState) {
	<div id="build-bundle-content">
		if state.Building {
			@buildBundleCard(tr.String("Building Bundle")) {
				<div class="loading-screen">
					@componentLoadingDots()
					<p>{ tr.String("Writing the .arb files and generating Go code…") }</p>
					<p class="loading-hint">
						{ tr.String("This may take a moment for large codebases.") }
					</p>
				</div>
			}
		} else if state.Err != "" {
			@buildBundleCard(tr.String("Build Failed")) {
				<div class="build-result">
					@componentAlertDanger() {
						{ state.Err }
					}
					if state.Duration > 0 {
						<p class="build-duration">
							{ tr.String("Failed after {text}", FmtDuration(tr, state.Duration)) }
						</p>
					}
					@componentDashboardLink(tr)
				</div>
			}
		} else if state.Duration > 0 {
			@buildBundleCard(tr.String("Build Successful")) {
				<div class="build-result">
					@neo.AlertAttrs(
						neo.AlertOpts{Variant: neo.Set(neo.AlertVariantSuccess)},
						templ.Attributes{"role": "status"},
					) {
						@neo.AlertContent() {
							@neo.AlertDescription() {
								{ tr.String("Bundle built successfully. " +
									"The .arb files and Go code have been updated.") }
							}
						}
					}
					<p class="build-duration">
						{ tr.String("Completed in {text}", FmtDuration(tr, state.Duration)) }
					</p>
					@componentDashboardLink(tr)
				</div>
			}
		} else {
			@buildBundleCard(tr.String("Build Bundle")) {
				<div class="build-result">
					if state.TotalChanges == 0 {
						<p>{ tr.String("No unsaved changes to build.") }</p>
					} else {
						<p>{ tr.String("{# unsaved changes} ready to build.", state.TotalChanges) }</p>
					}
					@componentDashboardLink(tr)
				</div>
			}
		}
	</div>
}
