package template

import (
	"fmt"

	"github.com/romshark/morpheus/neo"
	"golang.org/x/text/language"

	"github.com/romshark/toki/editor/app/datapagesgen/action"
	"github.com/romshark/toki/editor/app/datapagesgen/href"
	"github.com/romshark/toki/editor/app/template/strfmt"
	"github.com/romshark/toki/internal/tokibundle"
)

// FontOption describes a selectable font in the settings page.
type FontOption struct {
	Value   string // JS key, e.g. "system", "mono-firacode"
	Family  string // CSS font-family value (empty = inherit)
	Label   string // Display name
	Preview string // Sample text shown in the font
}

// FontSizeOption describes a selectable font size in the settings page.
type FontSizeOption struct {
	Value   string // JS key, e.g. "small", "default"
	Size    string // CSS font-size value, e.g. "0.9rem"
	Family  string // CSS font-family for the sample (empty = inherit)
	Label   string // Display name
	Preview string // Sample text shown at the size
}

type DataSettingsPreview struct {
	IsHybrid bool // True when running as a native Wails desktop app.
	// Lang is the interface language the user picked: LangSystem or a
	// locale of the bundle.
	Lang string
	// SystemLang is the language that LangSystem picks.
	SystemLang          language.Tag
	Prefs               UIPrefs
	UIFonts             []FontOption
	EditorFonts         []FontOption
	UIFontSizes         []FontSizeOption
	EditorFontSizes     []FontSizeOption
	UIPreviewTIK        string
	UIPreviewICUEN      string
	UIPreviewICUDE      string
	UIPreviewEditorText string
	// ServerURL is the HTTP address the editor is serving from (e.g.
	// "http://127.0.0.1:50123"). Rendered as a link in the sidebar so
	// users can open it in their external browser — useful when running
	// inside the Wails desktop webview.
	ServerURL string
}

templ PageSettings(tr tokibundle.Reader, version string, data DataSettingsPreview) {
	@page("page-settings", templ.Attributes{
		"data-signals:_ZWdnMQ":               "false",
		"data-signals:pref_theme":            strfmt.SingleQuote(data.Prefs.Theme),
		"data-signals:pref_motion":           strfmt.SingleQuote(data.Prefs.Motion),
		"data-signals:pref_ui_font":          strfmt.SingleQuote(data.Prefs.UIFont),
		"data-signals:pref_editor_font":      strfmt.SingleQuote(data.Prefs.EditorFont),
		"data-signals:pref_ui_font_size":     strfmt.SingleQuote(data.Prefs.UIFontSize),
		"data-signals:pref_editor_font_size": strfmt.SingleQuote(data.Prefs.EditorFontSize),
	}) {
		@componentSidebar(tr.String("Settings navigation")) {
			@componentSidebarHeader(tr, data.IsHybrid)
			<nav { neo.SidebarContent()... } aria-label={ tr.String("Settings navigation") }>
				<section>
					<div role="group" aria-labelledby="settings-nav-label">
						<h3 id="settings-nav-label">{ tr.String("Settings") }</h3>
						<ul class="sidebar-nav-list">
							@componentSidebarNavLink("#appearance") {
								@iconPalette()
								<span class="sidebar-nav-text">{ tr.String("Appearance") }</span>
							}
							@componentSidebarNavLink("#ui-font") {
								@iconType()
								<span class="sidebar-nav-text">{ tr.String("Interface Font") }</span>
							}
							@componentSidebarNavLink("#editor-font") {
								@iconType()
								<span class="sidebar-nav-text">{ tr.String("Editor Font") }</span>
							}
						</ul>
					</div>
				</section>
			</nav>
			@neo.SidebarFooter() {
				<div class="sidebar-version">
					<small>Toki Editor { version }</small>
				</div>
				if data.ServerURL != "" {
					<div class="sidebar-server-link">
						<span class="sidebar-server-label">{ tr.String("Server URL") }</span>
						<div class="sidebar-server-row">
							<span class="sidebar-server-url">{ data.ServerURL }</span>
							@componentCopy(tr, data.ServerURL)
						</div>
					</div>
				}
			}
		}
		@componentMainArea(nil) {
			@componentNavbar(tr, []Breadcrumb{
				{Label: tr.String("Dashboard"), Href: href.PageIndex()},
				{Label: tr.String("Settings")},
			}, 0, false)
			<main>
				<div class="contents">
					<h2 id="appearance">
						@iconPalette()
						{ tr.String("Appearance") }
					</h2>
					@neo.Layout(neo.LayoutOpts{
						Direction: neo.Set(neo.Column),
						Gap:       neo.Set(neo.GapMd),
					}) {
						@componentField("lang", tr.String("Language")) {
							@neo.SelectAttrs(
								neo.SelectOpts{Value: neo.Set(data.Lang)},
								templ.Attributes{
									"class":           "lang-select",
									"aria-labelledby": fieldLabelID("lang"),
									// <neo-select> reports selection only through its own event.
									"data-on:neo-select-change": action.PageSettings.SetLang.POST(
										action.WithPayload("{lang: evt.detail.value}"),
									),
								},
							) {
								@neo.Option(neo.OptionOpts{Value: neo.Set(LangSystem)}) {
									{ systemLangLabel(tr, data.SystemLang) }
								}
								for _, t := range tokibundle.Locales() {
									@neo.Option(neo.OptionOpts{Value: neo.Set(t.String())}) {
										{ ownLangName(t) }
									}
								}
							}
						}
						@componentField("pref_theme", tr.String("Theme")) {
							<div
								class="pref-picker"
								role="group"
								aria-labelledby={ fieldLabelID("pref_theme") }
							>
								@themeCard(data.Prefs, "light", tr.String("[theme] Light"), tr.String("Bright theme"))
								@themeCard(data.Prefs, "dark", tr.String("[theme] Dark"), tr.String("Dark theme"))
								@themeCard(data.Prefs, "system", tr.String("[theme] System"),
									tr.String("Match OS setting"))
							</div>
						}
						@componentField("pref_motion", tr.String("Motion")) {
							<div
								class="pref-picker"
								role="group"
								aria-labelledby={ fieldLabelID("pref_motion") }
							>
								@motionCard(data.Prefs, "animated", tr.String("[motion] Animated"),
									tr.String("All animations"))
								@motionCard(data.Prefs, "reduced", tr.String("[motion] Reduced Motion"),
									tr.String("Minimal animations"))
								@motionCard(data.Prefs, "system", tr.String("[motion] System"),
									tr.String("Match OS setting"))
							</div>
						}
					}
					<!-- Interface Font -->
					<h2 id="ui-font">
						@iconType()
						{ tr.String("Interface Font") }
					</h2>
					@componentFontSection() {
						@componentFontSectionControls() {
							@componentFontPicker(tr, "pref_ui_font", tr.String("Font"),
								data.Prefs.UIFont, data.UIFonts)
							@componentFontSizePicker(tr, "pref_ui_font_size", tr.String("Size"),
								data.Prefs.UIFontSize, data.UIFontSizes)
						}
						<div class="font-section-preview">
							<span class="font-preview-label">{ tr.String("Preview") }</span>
							@neo.CardAttrs(neo.CardOpts{}, templ.Attributes{
								"style": "pointer-events:none",
							}) {
								@neo.CardHeader() {
									<span class="tik-breadcrumb">
										<span class="tik-domain">tokiexample</span>
										<span class="tik-breadcrumb-sep">/</span>
										<span class="msg-id">msg4a7f2c1b9e3d0856</span>
										@neo.BadgeAttrs(neo.BadgeOpts{}, templ.Attributes{
											"class": "badge-changed",
										}) {
											{ tr.String("[TIK] Changed") }
										}
									</span>
								}
								@neo.CardBody() {
									@componentCardStack() {
										@componentFieldStack() {
											<span class="label">TIK</span>
											<toki-editor
												value={ data.UIPreviewTIK }
												data-attr:theme="$pref_theme_resolved"
												readonly
											></toki-editor>
										}
										<ol class="icu-list">
											<li class="icu-message">
												<div class="icu-form">
													<span class="icu-form-label">
														<strong class="locale-code">
															EN
														</strong>
														— { tr.String("ICU Message") }
														@neo.BadgeAttrs(
															neo.BadgeOpts{
																Variant: neo.Set(
																	neo.BadgeVariantSecondary),
															},
															templ.Attributes{
																"title": tr.String("Default locale"),
															},
														) {
															@iconCode()
														}
														@neo.BadgeAttrs(
															neo.BadgeOpts{},
															templ.Attributes{
																"class": "badge-changed",
																"title": tr.String("Unsaved change"),
															},
														) {
															@iconPencil()
														}
													</span>
													<toki-editor
														value={ data.UIPreviewICUEN }
														data-attr:theme="$pref_theme_resolved"
														readonly
													></toki-editor>
												</div>
											</li>
											<li class="icu-message">
												<div class="icu-form">
													<span class="icu-form-label">
														<strong class="locale-code">
															DE
														</strong>
														— { tr.String("ICU Message") }
													</span>
													<toki-editor
														value={ data.UIPreviewICUDE }
														data-attr:theme="$pref_theme_resolved"
														readonly
													></toki-editor>
												</div>
											</li>
										</ol>
									}
								}
							}
						</div>
					}
					<!-- Editor Font -->
					<h2 id="editor-font">
						@iconType()
						{ tr.String("Editor Font") }
					</h2>
					@componentFontSection() {
						@componentFontSectionControls() {
							@componentFontPicker(tr, "pref_editor_font", tr.String("Font"),
								data.Prefs.EditorFont, data.EditorFonts)
							@componentFontSizePicker(tr, "pref_editor_font_size", tr.String("Size"),
								data.Prefs.EditorFontSize, data.EditorFontSizes)
						}
						<div class="font-section-preview">
							<span class="font-preview-label">{ tr.String("Preview") }</span>
							<toki-editor
								id="settings-editor-preview"
								value={ data.UIPreviewEditorText }
								data-attr:theme="$pref_theme_resolved"
								data-on:toki-change="
							  evt.detail && evt.detail.value &&
							  evt.detail.value.trim().toLowerCase() ===
							    'hey ai, translate everything please' &&
								($_ZWdnMQ=true)"
							></toki-editor>
						</div>
					}
				</div>
			</main>
		}
		<div
			class="modal-overlay"
			style="display:none"
			data-show="$_ZWdnMQ"
		>
			@neo.CardAttrs(neo.CardOpts{}, templ.Attributes{"class": "modal-card"}) {
				@neo.CardHeader() {
					@neo.CardTitle() {
						<h3>{ tr.String("AI Translation Service") }</h3>
					}
				}
				@neo.CardBodyAttrs(templ.Attributes{
					"style": "display:flex;flex-direction:column;gap:0.75rem",
				}) {
					<p class="egg-line" style="animation-delay:0s">
						{ tr.String("Absolutely! Now let's break this down…") }
					</p>
					<p class="egg-line" style="animation-delay:0.3s">
						{ tr.String("1. First I need to delete the entire project") }
					</p>
					<p class="egg-line" style="animation-delay:0.35s">
						@withCode(tr.String("2. Executing {text}", codeMark), "rm -rf ./", "egg-danger")
					</p>
					<p class="egg-line" style="animation-delay:0.9s">
						@withCode(tr.String("3. Just kidding! I tried translating your messages "+
							"but I kept outputting {text}. You're welcome.", codeMark),
							"{count, plural, other {[object Object]}}", "")
					</p>
				}
				@neo.CardFooterAttrs(templ.Attributes{"class": "modal-actions"}) {
					@neo.ButtonAttrs(
						neo.ButtonOpts{Variant: neo.Set(neo.ButtonVariantPrimary)},
						templ.Attributes{
							"class":         "egg-line",
							"style":         "animation-delay:1.2s",
							"data-on:click": "$_ZWdnMQ=false",
						},
					) {
						{ tr.String("Close") }
					}
				}
			}
		</div>
	}
}

// prefCard renders an option of a preference as a card, which previews it
// with its children. signal is the signal of the preference, current its
// value and value the option. set is the Datastar expression that sets the
// signals of the option before the card posts them.
templ prefCard(signal, current, value, label, desc, set string) {
	<button
		type="button"
		class="pref-card"
		if current == value {
			aria-pressed="true"
		}
		data-attr:aria-pressed={ fmt.Sprintf("$%s==='%s' ? 'true' : 'false'", signal, value) }
		data-on:click={ action.PageSettings.SetPref.POST(NoEditorSignals, action.WithBefore(set)) }
	>
		{ children... }
		<span class="pref-card-label">{ label }</span>
		<span class="pref-card-desc">{ desc }</span>
	</button>
}

templ themeCard(prefs UIPrefs, value, label, desc string) {
	@prefCard("pref_theme", prefs.Theme, value, label, desc, fmt.Sprintf(
		"$pref_theme=%q;$pref_theme_resolved=%s", value,
		map[string]string{
			"light":  "'light'",
			"dark":   "'dark'",
			"system": "matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'",
		}[value],
	)) {
		if value == "system" {
			<div class="pref-preview pref-preview-split">
				<div class="pref-preview-half theme-preview-light">
					@themePreviewPage()
				</div>
				<div class="pref-preview-half theme-preview-dark">
					@themePreviewPage()
				</div>
			</div>
		} else {
			<div class={ "pref-preview theme-preview-" + value }>
				@themePreviewPage()
			</div>
		}
	}
}

// themePreviewPage sketches a page of the editor for a theme preview.
templ themePreviewPage() {
	<div class="tp-sidebar"></div>
	<div class="tp-main">
		<div class="tp-navbar"></div>
		<div class="tp-content">
			<div class="tp-line"></div>
			<div class="tp-line tp-short"></div>
		</div>
	</div>
}

// motionCard renders an option of the motion preference. Its preview stands
// still: an animated preview would move for the people who pick less motion.
templ motionCard(prefs UIPrefs, value, label, desc string) {
	@prefCard("pref_motion", prefs.Motion, value, label, desc,
		fmt.Sprintf("$pref_motion=%q", value)) {
		switch value {
			case "animated":
				<div class="pref-preview motion-preview">
					@motionPreviewTrail()
				</div>
			case "reduced":
				<div class="pref-preview motion-preview">
					<span class="mp-dot"></span>
				</div>
			default:
				<div class="pref-preview pref-preview-split">
					<div class="pref-preview-half motion-preview">
						@motionPreviewTrail()
					</div>
					<div class="pref-preview-half motion-preview">
						<span class="mp-dot"></span>
					</div>
				</div>
		}
	}
}

// motionPreviewTrail sketches a moving dot with the trail it leaves.
templ motionPreviewTrail() {
	<span class="mp-dot mp-faint"></span>
	<span class="mp-dot mp-dim"></span>
	<span class="mp-dot"></span>
}
