package template

import (
	"github.com/romshark/morpheus/neo"

	"github.com/romshark/toki/internal/tokibundle"
)

templ PageLoading(tr tokibundle.Reader) {
	@page("page-loading", nil) {
		<div class="page-center">
			<meta http-equiv="refresh" content="1"/>
			@neo.Card(neo.CardOpts{}) {
				@neo.CardHeader() {
					@neo.CardTitle() {
						<h1>Toki Editor</h1>
					}
				}
				@neo.CardBody() {
					<div class="loading-screen">
						@componentLoadingDots()
						<p>{ tr.String("Rebuilding the index database…") }</p>
						<p class="loading-hint">
							{ tr.String("This may take a moment for large codebases.") }
						</p>
					</div>
				}
			}
		</div>
	}
}
