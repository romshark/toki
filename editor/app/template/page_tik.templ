package template

import (
	"fmt"

	"github.com/romshark/morpheus/neo"

	"github.com/romshark/toki/editor/app/datapagesgen/action"
	"github.com/romshark/toki/editor/app/datapagesgen/href"
	"github.com/romshark/toki/internal/tokibundle"
)

// PageTIK renders the whole page of one TIK. It is both the GET body and
// what PageTIK.OnUpdated morphs. closedSections is as in [DataIndex.ClosedSections].
templ PageTIK(tr tokibundle.Reader, tk *TIK, isHybrid bool, closedSections map[string]bool) {
	@page("page-tik", templ.Attributes{
		"data-signals:icumsg":            "''",
		"data-signals:resettikid":        "''",
		"data-signals:resetlocale":       "''",
		"data-signals:resetmodalopen":    "false",
		"data-signals:resetdonetikid":    "''",
		"data-signals:resetdonelocale":   "''",
		"data-signals:editor__ifmissing": InitEditorSignalsOne(tk),
	}) {
		@componentSidebar(tr.String("TIK navigation")) {
			@componentSidebarHeader(tr, isHybrid)
			@tikSidebarNav(tr, tk, closedSections)
		}
		@tikMainArea(tr, tk, closedSections)
		@componentEditorModals(tr)
	}
}

// tikSidebarNav links to the parts of the TIK page. The links to the ICU
// messages are a collapsible section, whose locales the user reorders.
templ tikSidebarNav(tr tokibundle.Reader, tk *TIK, closedSections map[string]bool) {
	<nav
		{ neo.SidebarContent()... }
		id="tik-sidebar-content"
		aria-label={ tr.String("TIK navigation") }
	>
		<ul class="sidebar-nav-list">
			@componentSidebarNavLink("#tik-card") {
				<span class="sidebar-nav-text">TIK</span>
			}
			if len(tk.Occurrences) > 0 {
				@componentSidebarNavLink("#source-occurrences") {
					<span class="sidebar-nav-text">{ tr.String("Source Occurrences") }</span>
				}
			}
		</ul>
		@componentSidebarSection(SectionMessages, tr.String("ICU Messages"), closedSections,
			tikSectionToggle(tk.ID, SectionMessages)) {
			@componentLocaleSortable() {
				for _, msg := range tk.ICU {
					@componentLocaleSortableItem(msg.Catalog.Locale) {
						@componentSidebarNavAnchor(fmt.Sprintf("#icu-%s-%s",
							tk.ID, msg.Catalog.Locale,
						)) {
							<span class="locale-link-name sidebar-nav-text">
								<strong class="locale-code">
									{ msg.Catalog.Locale }
								</strong>
								if name := localeName(tr, msg.Catalog.Locale); name != "" {
									– { name }
								}
							</span>
							if msg.Catalog.Default {
								@neo.BadgeAttrs(
									neo.BadgeOpts{Variant: neo.Set(neo.BadgeVariantSecondary)},
									templ.Attributes{"title": tr.String("Default locale")},
								) {
									@iconCode()
								}
							}
							if msg.Changed {
								@neo.BadgeAttrs(neo.BadgeOpts{}, templ.Attributes{
									"class": "badge-changed",
									"title": tr.String("Unsaved change"),
								}) {
									@iconPencil()
								}
							}
							if msg.Message == "" {
								@neo.BadgeAttrs(
									neo.BadgeOpts{Variant: neo.Set(neo.BadgeVariantSecondary)},
									templ.Attributes{"title": tr.String("Missing Translation")},
								) {
									@iconCircleMinus()
								}
							}
							if msg.Error != nil || len(msg.Problems) > 0 {
								@neo.BadgeAttrs(
									neo.BadgeOpts{Variant: neo.Set(neo.BadgeVariantDanger)},
									templ.Attributes{"title": tr.String("Invalid ICU message")},
								) {
									@iconAlertTriangle()
								}
							}
						}
					}
				}
			}
		}
	</nav>
}

templ tikMainArea(tr tokibundle.Reader, tk *TIK, closedSections map[string]bool) {
	@componentMainArea(templ.Attributes{"id": "tik-main-area"}) {
		@componentNavbar(tr, []Breadcrumb{
			{Label: tr.String("Dashboard"), Href: href.PageIndex()},
			{Label: tr.String("Messages"), Href: href.PageTIKs(href.QueryPageTIKs{})},
			{Label: tk.ID},
		}, tikChangedCount(tk), true)
		<main>
			<div class="contents">
				@neo.CardAttrs(neo.CardOpts{}, templ.Attributes{
					"class": "tik-card",
					"id":    "tik-card",
				}) {
					@neo.CardHeader() {
						<span class="tik-breadcrumb">
							if tk.Domain != "" {
								<span class="tik-domain">{ tk.Domain }</span>
								<span class="tik-breadcrumb-sep">/</span>
							}
							<span class="msg-id">{ tk.ID }</span>
						</span>
					}
					@neo.CardBody() {
						@componentCardStack() {
							@componentFieldStack() {
								<span class="label">
									TIK
									@componentCopy(tr, tk.TIK)
								</span>
								<toki-editor
									value={ tk.TIK }
									data-attr:theme="$pref_theme_resolved"
									readonly
								></toki-editor>
							}
							if tk.Description != "" {
								@componentFieldStack() {
									<span class="label">{ tr.String("Description") }</span>
									<p>{ tk.Description }</p>
								}
							}
						}
					}
				}
				if len(tk.Occurrences) > 0 {
					@tikOccurrences(tr, tk, closedSections)
				}
				<h2 id="icu-messages">
					@iconLanguages()
					{ tr.String("ICU Messages") }
				</h2>
				for _, msg := range tk.ICU {
					@neo.CardAttrs(neo.CardOpts{}, templ.Attributes{
						"id": fmt.Sprintf("icu-%s-%s", tk.ID, msg.Catalog.Locale),
					}) {
						@neo.CardHeader() {
							<span class="icu-form-label">
								<strong class="locale-code">
									{ msg.Catalog.Locale }
								</strong>
								if name := localeName(tr, msg.Catalog.Locale); name != "" {
									— { name }
								}
								@componentICUMessageStatusButtons(tr, msg)
								@componentCopy(tr, msg.Message)
							</span>
						}
						@neo.CardBody() {
							@componentICUMessageForm(tr, tk.ID, msg, false, templ.Attributes{
								"data-on:toki-change": action.PageTIK.Set.POST(
									tk.ID,
									action.PageTIK.Set.POSTQuery(msg.Catalog.Locale),
									NoEditorSignals,
									editorChangeBefore(tk.ID, msg.Catalog.Locale),
								),
							})
						}
					}
				}
			</div>
		</main>
	}
}

// tikOccurrences lists where the source code uses tk, in a section that the
// user closes when the list pushes the ICU messages too far down.
templ tikOccurrences(tr tokibundle.Reader, tk *TIK, closedSections map[string]bool) {
	@neo.CollapsibleAttrs(neo.CollapsibleOpts{
		Open: sectionOpen(closedSections, SectionOccurrences),
	}, templ.Attributes{
		"class":                          "page-section",
		"role":                           "group",
		"aria-labelledby":                "source-occurrences",
		"data-on:neo-collapsible-toggle": tikSectionToggle(tk.ID, SectionOccurrences),
	}) {
		<h2 slot="summary" id="source-occurrences">
			@iconCode()
			{ tr.String("Source Occurrences") }
		</h2>
		@neo.Card(neo.CardOpts{}) {
			@neo.CardBody() {
				<ul class="occurrence-list">
					for _, occ := range tk.Occurrences {
						<li
							class="occurrence-item"
							title={ fmt.Sprintf("%s:%d:%d",
								occ.File, occ.Line, occ.Column) }
						>
							<code class="occurrence-file">
								{ occ.DisplayFile }
								<span class="occurrence-pos">
									{ occ.Pos() }
								</span>
							</code>
							@componentCopy(tr, fmt.Sprintf(
								"%s:%d:%d", occ.File, occ.Line, occ.Column,
							))
						</li>
					}
				</ul>
			}
		}
	}
}
