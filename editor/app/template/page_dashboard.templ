package template

import (
	"github.com/romshark/morpheus/neo"

	"github.com/romshark/toki/editor/app/datapagesgen/href"
	"github.com/romshark/toki/internal/tokibundle"
)

templ PageDashboard(tr tokibundle.Reader, stats DashboardStats) {
	@page("page-dashboard", nil) {
		@componentSidebar(tr.String("Dashboard navigation")) {
			@componentSidebarHeader(tr, stats.IsHybrid)
			<nav { neo.SidebarContent()... } aria-label={ tr.String("Dashboard navigation") }>
				<section>
					<div role="group">
						<h3>{ tr.String("Navigation") }</h3>
						<ul class="sidebar-nav-list">
							@componentSidebarNavLink("#overview") {
								@iconLayoutDashboard()
								<span class="sidebar-nav-text">{ tr.String("Overview") }</span>
							}
							if len(stats.Domains) > 0 {
								@componentSidebarNavLink("#domains") {
									@iconHierarchy()
									<span class="sidebar-nav-text">{ tr.String("Domains") }</span>
									@neo.Badge(neo.BadgeOpts{
										Variant: neo.Set(neo.BadgeVariantSecondary),
									}) {
										{ fmtInt(tr, stats.NumDomains) }
									}
								}
							}
							@componentSidebarNavLink("#locales") {
								@iconLanguages()
								<span class="sidebar-nav-text">{ tr.String("Locales") }</span>
								@neo.Badge(neo.BadgeOpts{
									Variant: neo.Set(neo.BadgeVariantSecondary),
								}) {
									{ fmtInt(tr, stats.NumLocales) }
								}
							}
						</ul>
					</div>
				</section>
			</nav>
			@componentSidebarFooter(tr, stats.Dir)
		}
		@componentMainArea(nil) {
			@componentNavbar(tr, []Breadcrumb{
				{Label: tr.String("Dashboard")},
			}, stats.TotalChanges, stats.CanApplyChanges)
			<main>
				<div class="contents">
					<h2 id="overview">
						@iconLayoutDashboard()
						{ tr.String("Overview") }
					</h2>
					<div class="dashboard-grid">
						<a
							href={ href.PageTIKs(href.QueryPageTIKs{
								Locales: stats.NativeLocale.Locale,
							}) }
							class="dashboard-stat-link native-locale-cell"
						>
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value locale-code">
										{ stats.NativeLocale.Locale }
									</span>
									if name := localeName(tr, stats.NativeLocale.Locale); name != "" {
										<span class="dashboard-stat-label">{ name }</span>
									}
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">
										{ tr.String("Native locale") }
										@neo.Tooltip(neo.TooltipOpts{
											Text: neo.Set(tr.String(
												"The language used in source code message declarations")),
											Placement: neo.Set(neo.PlacementBottomStart),
										}) {
											<span class="info-icon">
												@iconInfo()
											</span>
										}
									</p>
								}
							}
						</a>
						<a href="#locales" class="dashboard-stat-link">
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtInt(tr, stats.NumLocales) }
									</span>
									<span class="dashboard-stat-label">
										@iconLanguages()
										{ tr.String("Locales") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">{ tr.String("Languages configured") }</p>
								}
							}
						</a>
						<a href="#domains" class="dashboard-stat-link">
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtInt(tr, stats.NumDomains) }
									</span>
									<span class="dashboard-stat-label">
										@iconHierarchy()
										{ tr.String("Domains") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">{ tr.String("TIK domain scopes") }</p>
								}
							}
						</a>
						<a href={ href.PageTIKs(href.QueryPageTIKs{}) } class="dashboard-stat-link">
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtInt(tr, stats.NumTIKs) }
									</span>
									<span class="dashboard-stat-label">
										@iconList()
										{ tr.String("[TIKs] TIKs") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">{ tr.String("Total translation keys") }</p>
								}
							}
						</a>
						<a
							href={ href.PageTIKs(href.QueryPageTIKs{
								Filter: "complete",
							}) }
							class="dashboard-stat-link"
						>
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtPercent(tr, stats.Completeness) }
									</span>
									<span class="dashboard-stat-label">
										@iconCircleCheck()
										{ tr.String("[TIKs] Complete") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">
										{ tr.String("{integer} of {# TIKs}", stats.NumComplete, stats.NumTIKs) }
									</p>
								}
							}
						</a>
						<a
							href={ href.PageTIKs(href.QueryPageTIKs{
								Filter: "changed",
							}) }
							class="dashboard-stat-link"
						>
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtInt(tr, stats.TotalChanges) }
									</span>
									<span class="dashboard-stat-label">
										@iconPencil()
										{ tr.String("[changes] Unsaved") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">{ tr.String("Pending changes") }</p>
								}
							}
						</a>
						<a
							href={ href.PageTIKs(href.QueryPageTIKs{
								Filter: "incomplete",
							}) }
							class="dashboard-stat-link"
						>
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtInt(tr, stats.NumIncomplete) }
									</span>
									<span class="dashboard-stat-label">
										@iconCircleSlash()
										{ tr.String("[TIKs] Incomplete") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">
										{ tr.String("TIKs with missing translations") }
									</p>
								}
							}
						</a>
						<a
							href={ href.PageTIKs(href.QueryPageTIKs{
								Filter: "untranslated",
							}) }
							class="dashboard-stat-link"
						>
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtInt(tr, stats.NumUntranslated) }
									</span>
									<span class="dashboard-stat-label">
										@iconCircleMinus()
										{ tr.String("[TIKs] Untranslated") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">{ tr.String("TIKs with no translation") }</p>
								}
							}
						</a>
						<a
							href={ href.PageTIKs(href.QueryPageTIKs{
								Filter: "invalid",
							}) }
							class="dashboard-stat-link"
						>
							@componentStatLinkCard() {
								@neo.CardHeader() {
									<span class="dashboard-stat-value">
										{ fmtInt(tr, stats.NumInvalid) }
									</span>
									<span class="dashboard-stat-label">
										@iconAlertTriangle()
										{ tr.String("[TIKs] Invalid") }
									</span>
								}
								@neo.CardBody() {
									<p class="dashboard-stat-desc">{ tr.String("TIKs with ICU errors") }</p>
								}
							}
						</a>
					</div>
					if stats.TotalChanges > 0 {
						@neo.CardAttrs(neo.CardOpts{}, templ.Attributes{
							"class": "build-bundle-card",
						}) {
							@neo.CardHeader() {
								<h3>
									@iconSave()
									{ tr.String("Build Bundle") }
								</h3>
							}
							@neo.CardBody() {
								<p>
									{ tr.String("You have {# unsaved changes}. " +
										"Build the bundle to update the .arb files and regenerate the Go code.",
										stats.TotalChanges) }
								</p>
								@neo.Link(neo.LinkOpts{
									Href:     neo.Set(href.PageBuildBundle()),
									Variant:  neo.Set(neo.LinkVariantButtonPrimary),
									Disabled: neo.Set(!stats.CanApplyChanges),
								}) {
									@iconSave()
									{ tr.String("Build Bundle") }
								}
								if !stats.CanApplyChanges {
									@componentAlertDanger() {
										{ tr.String("Fix all invalid ICU messages before building.") }
									}
								}
							}
						}
					}
					if len(stats.Domains) > 0 {
						<h2 id="domains">
							@iconHierarchy()
							{ tr.String("Domains") }
							@neo.Badge(neo.BadgeOpts{
								Variant: neo.Set(neo.BadgeVariantSecondary),
							}) {
								{ fmtInt(tr, stats.NumDomains) }
							}
						</h2>
						for _, d := range stats.Domains {
							@dashboardDomainCard(tr, d)
						}
					}
					<h2 id="locales">
						@iconLanguages()
						{ tr.String("Locales") }
						@neo.Badge(neo.BadgeOpts{
							Variant: neo.Set(neo.BadgeVariantSecondary),
						}) {
							{ fmtInt(tr, stats.NumLocales) }
						}
					</h2>
					<div class="dashboard-grid">
						for _, ls := range stats.Locales {
							<a
								href={ href.PageTIKs(href.QueryPageTIKs{
									Locales: ls.Locale,
								}) }
								class="dashboard-stat-link locale-card"
							>
								@componentStatLinkCard() {
									@neo.CardHeader() {
										<span class="dashboard-stat-value">
											<strong class="locale-code">{ ls.Locale }</strong>
											if name := localeName(tr, ls.Locale); name != "" {
												<span class="locale-name">– { name }</span>
											}
										</span>
									}
									@neo.CardBody() {
										@componentCompletenessBar(tr, ls.Completeness)
										<div class="locale-stats">
											<div class="locale-stat-row">
												<span>{ tr.String("[TIKs] Complete") }</span>
												<span>{ fmtInt(tr, ls.Complete) }</span>
											</div>
											<div class="locale-stat-row">
												<span>{ tr.String("[TIKs] Incomplete") }</span>
												<span>{ fmtInt(tr, ls.Incomplete) }</span>
											</div>
											if ls.Untranslated > 0 {
												<div class="locale-stat-row">
													<span>{ tr.String("[TIKs] Untranslated") }</span>
													<span>{ fmtInt(tr, ls.Untranslated) }</span>
												</div>
											}
											if ls.Invalid > 0 {
												<div class="locale-stat-row">
													<span>{ tr.String("[TIKs] Invalid") }</span>
													@neo.Badge(neo.BadgeOpts{
														Variant: neo.Set(neo.BadgeVariantDanger),
													}) {
														{ fmtInt(tr, ls.Invalid) }
													}
												</div>
											}
											if ls.Changed > 0 {
												<div class="locale-stat-row">
													<span>{ tr.String("[changes] Unsaved") }</span>
													@neo.BadgeAttrs(neo.BadgeOpts{}, templ.Attributes{
														"class": "badge-changed",
													}) {
														{ fmtInt(tr, ls.Changed) }
													}
												</div>
											}
										</div>
									}
								}
							</a>
						}
					</div>
				</div>
			</main>
		}
	}
}

templ dashboardDomainCard(tr tokibundle.Reader, d DomainInfo) {
	@neo.CardAttrs(neo.CardOpts{}, templ.Attributes{"class": "domain-card"}) {
		@neo.CardHeader() {
			@neo.CardTitle() {
				{ d.Name }
			}
		}
		@neo.CardBody() {
			@componentFieldStack() {
				<span class="label">{ tr.String("Directory") }</span>
				<p class="domain-dir-path"><bdi>{ d.Dir }</bdi></p>
			}
			@componentCompletenessBar(tr, d.Completeness)
			<div class="domain-stats-grid">
				<a href={ href.PageTIKs(href.QueryPageTIKs{Domains: d.FullName}) } class="domain-stat">
					@componentDomainStat(fmtInt(tr, d.NumTIKs), tr.String("[TIKs] TIKs"), iconList())
				</a>
				<a
					href={ href.PageTIKs(href.QueryPageTIKs{
						Domains: d.FullName, Filter: "complete",
					}) }
					class="domain-stat"
				>
					@componentDomainStat(
						fmtInt(tr, d.NumComplete), tr.String("[TIKs] Complete"), iconCircleCheck(),
					)
				</a>
				if d.NumIncomplete > 0 {
					<a
						href={ href.PageTIKs(href.QueryPageTIKs{
							Domains: d.FullName, Filter: "incomplete",
						}) }
						class="domain-stat"
					>
						@componentDomainStat(
							fmtInt(tr, d.NumIncomplete), tr.String("[TIKs] Incomplete"), iconCircleSlash(),
						)
					</a>
				}
				if d.NumUntranslated > 0 {
					<a
						href={ href.PageTIKs(href.QueryPageTIKs{
							Domains: d.FullName, Filter: "untranslated",
						}) }
						class="domain-stat"
					>
						@componentDomainStat(
							fmtInt(tr, d.NumUntranslated), tr.String("[TIKs] Untranslated"),
							iconCircleMinus(),
						)
					</a>
				}
				if d.NumInvalid > 0 {
					<a
						href={ href.PageTIKs(href.QueryPageTIKs{
							Domains: d.FullName, Filter: "invalid",
						}) }
						class="domain-stat"
					>
						@componentDomainStat(
							fmtInt(tr, d.NumInvalid), tr.String("[TIKs] Invalid"), iconAlertTriangle(),
						)
					</a>
				}
				if d.NumChanged > 0 {
					<a
						href={ href.PageTIKs(href.QueryPageTIKs{
							Domains: d.FullName, Filter: "changed",
						}) }
						class="domain-stat"
					>
						@componentDomainStat(
							fmtInt(tr, d.NumChanged), tr.String("[changes] Unsaved"), iconPencil(),
						)
					</a>
				}
			</div>
		}
	}
	for _, sub := range d.SubDomains {
		@dashboardDomainCard(tr, sub)
	}
}
